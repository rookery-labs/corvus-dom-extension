{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorvusJSONRPCContracts",
  "description": "Strict JSON-RPC 2.0 schemas for WebExtension and GeckoView / Corvus Android IPC",
  "definitions": {
    "JsonRpcRequest": {
      "type": "object",
      "required": ["jsonrpc", "method", "id"],
      "properties": {
        "jsonrpc": { "type": "string", "enum": ["2.0"] },
        "id": { "type": ["string", "number"] },
        "method": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "JsonRpcNotification": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "type": "string", "enum": ["2.0"] },
        "method": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "JsonRpcResponse": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "type": "string", "enum": ["2.0"] },
        "id": { "type": ["string", "number", "null"] },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {}
          }
        }
      },
      "oneOf": [
        { "required": ["result"] },
        { "required": ["error"] }
      ]
    },
    "DomObservationParams": {
      "type": "object",
      "properties": {
        "includeBoundingBoxes": { "type": "boolean", "default": false },
        "maxDepth": { "type": "integer", "minimum": 1, "default": 32 }
      },
      "additionalProperties": false
    },
    "DomObservationResult": {
      "type": "object",
      "required": ["url", "title", "viewport", "tree", "nodeCount", "interactiveCount"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "viewport": {
          "type": "object",
          "required": ["width", "height", "scrollX", "scrollY"],
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" },
            "scrollX": { "type": "number" },
            "scrollY": { "type": "number" }
          }
        },
        "tree": { "type": "string" },
        "nodeCount": { "type": "integer", "minimum": 0 },
        "interactiveCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ActionExecuteParams": {
      "type": "object",
      "required": ["actionType", "nodeId"],
      "properties": {
        "nodeId": { "type": "integer", "minimum": 1 },
        "actionType": {
          "type": "string",
          "enum": ["click", "type", "clear", "scroll_into_view", "hover", "select"]
        },
        "text": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ActionExecuteResult": {
      "type": "object",
      "required": ["success", "nodeId", "actionType"],
      "properties": {
        "success": { "type": "boolean" },
        "nodeId": { "type": "integer" },
        "actionType": { "type": "string" },
        "executionTimeMs": { "type": "number" },
        "errorMessage": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AgentStatusUpdateParams": {
      "type": "object",
      "required": ["status", "stepIndex"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["IDLE", "OBSERVING", "THINKING_S1", "THINKING_S2", "EXECUTING", "COMPLETED", "ERROR"]
        },
        "stepIndex": { "type": "integer", "minimum": 0 },
        "currentGoal": { "type": "string" },
        "lastLatencyMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
